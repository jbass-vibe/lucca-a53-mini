<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardElevation="0dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Time Picker row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnOnTime"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="ON 07:00"
                    android:fontFamily="serif"
                    android:textSize="14sp"
                    android:textColor="@color/cream"
                    android:backgroundTint="@color/on_btn_bg"
                    style="@style/Widget.MaterialComponents.Button"
                    android:stateListAnimator="@null"
                    app:cornerRadius="12dp"/>

                <Button
                    android:id="@+id/btnOffTime"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="OFF 08:00"
                    android:fontFamily="serif"
                    android:textSize="14sp"
                    android:textColor="@color/cream"
                    android:backgroundTint="@color/off_btn_bg"
                    style="@style/Widget.MaterialComponents.Button"
                    android:stateListAnimator="@null"
                    app:cornerRadius="12dp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_delete"
                android:background="@drawable/bg_icon_btn"
                android:tint="#FF888888"
                android:contentDescription="Delete entry"/>

        </LinearLayout>

        <!-- Conflict warning -->
        <TextView
            android:id="@+id/tvConflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠  ON and OFF times are the same"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="#FFFF7043"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Day checkboxes -->
        <LinearLayout
            android:id="@+id/daysContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <!-- Programmatically inflated day buttons go here -->
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
