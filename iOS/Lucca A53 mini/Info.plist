<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ── Required Bluetooth permissions ──────────────────────────────── -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>This app uses Bluetooth to connect to your La Spaziale LUCCA A53 Mini espresso machine and program its weekly on/off schedule.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>This app uses Bluetooth to connect to your La Spaziale LUCCA A53 Mini espresso machine.</string>

    <!-- ── App metadata ─────────────────────────────────────────────────── -->
    <key>CFBundleName</key>
    <string>Lucca BT Remote</string>

    <key>CFBundleDisplayName</key>
    <string>Lucca BT Remote</string>

    <key>CFBundleIdentifier</key>
    <string>com.luccaa53mini.app</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>bluetooth-le</string>
        <string>armv7</string>
    </array>

    <!-- ── Background BLE (keep connection alive) ────────────────────── -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
